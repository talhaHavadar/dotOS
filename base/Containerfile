FROM scratch AS ctx

COPY ../scripts/ /scripts
COPY base/branding/ /branding

FROM docker.io/library/debian:unstable AS base

# Keep downloaded .debs so the apt cache mounts below are actually reused
RUN rm -f /etc/apt/apt.conf.d/docker-clean && \
    echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache

FROM base AS builder

RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root --mount=type=tmpfs,dst=/boot \
    --mount=type=cache,dst=/var/cache/apt,sharing=locked \
    --mount=type=cache,dst=/var/lib/apt/lists,sharing=locked \
    apt update -y && \
    apt install -y git curl make build-essential go-md2man libzstd-dev pkgconf dracut libostree-dev ostree libclang-dev ignition

ENV CARGO_HOME=/tmp/rust
ENV RUSTUP_HOME=/tmp/rust
WORKDIR /home/build
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/tmp/rust \
    --mount=type=cache,dst=/var/cache/cargo-target \
    curl --proto '=https' --tlsv1.2 -sSf "https://sh.rustup.rs" | sh -s -- --profile minimal -y && \
    sh -c ". ${RUSTUP_HOME}/env ; /ctx/scripts/build.sh"

FROM base AS system
COPY --from=builder /output /

RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root --mount=type=tmpfs,dst=/boot \
  --mount=type=cache,dst=/var/cache/apt,sharing=locked \
  --mount=type=cache,dst=/var/lib/apt/lists,sharing=locked \
  apt update -y && \
  apt install -y btrfs-progs bubblewrap dosfstools e2fsprogs fdisk firmware-linux-free linux-image-generic netplan.io libnss-resolve libnss-myhostname openssh-server skopeo systemd systemd-boot* systemd-resolved xfsprogs libostree-dev && \
  cp /boot/vmlinuz-* "$(find /usr/lib/modules -maxdepth 1 -type d | tail -n 1)/vmlinuz"

RUN systemctl enable systemd-networkd systemd-resolved ssh && \
    printf 'L! /etc/resolv.conf - - - - /run/systemd/resolve/stub-resolv.conf\n' \
        > /usr/lib/tmpfiles.d/resolv-conf.conf && \
    mkdir -p /etc/netplan && \
    printf 'network:\n  version: 2\n  ethernets:\n    all-en:\n      match:\n        name: en*\n      dhcp4: true\n      dhcp4-overrides:\n        use-domains: true\n      dhcp6: true\n      dhcp6-overrides:\n        use-domains: true\n    all-eth:\n      match:\n        name: eth*\n      dhcp4: true\n      dhcp4-overrides:\n        use-domains: true\n      dhcp6: true\n      dhcp6-overrides:\n        use-domains: true\n' > /etc/netplan/90-default.yaml && \
    sed -i 's/^#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config || true

# dotOS identity (os-release, issue, motd); before the initramfs, which embeds os-release
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/scripts/branding.sh /ctx/branding && \
    /ctx/scripts/os-release.sh variant base Base

RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/root \
    --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/scripts/initramfs.sh

# /var is machine state on bootc and is wiped below, so the dpkg database moves
# into the image (like rpm-ostree's /usr/lib/sysimage/rpm). Derived images can
# apt-get install at build time; at runtime /usr is read-only, so dpkg can be
# queried but nothing can be installed.
RUN mkdir -p /usr/lib/sysimage && \
    mv /var/lib/dpkg /usr/lib/sysimage/dpkg && \
    printf 'L /var/lib/dpkg - - - - /usr/lib/sysimage/dpkg\n' > /usr/lib/tmpfiles.d/dpkg-sysimage.conf

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    sed -i 's|^HOME=.*|HOME=/var/home|' "/etc/default/useradd" && \
    /ctx/scripts/bootc-rootfs.sh

# Set by `just build`; declared late so a new version only rebuilds from here
ARG DOTOS_VERSION
ARG DOTOS_COMMIT=""
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    /ctx/scripts/os-release.sh version "${DOTOS_VERSION:?set by just build}" "${DOTOS_COMMIT}"

LABEL containers.bootc="1" \
      org.opencontainers.image.title="dotOS Base" \
      org.opencontainers.image.description="Minimal bootc base image of dotOS, built on Debian unstable" \
      org.opencontainers.image.source="https://github.com/talhaHavadar/dotOS" \
      org.opencontainers.image.version="${DOTOS_VERSION}" \
      org.opencontainers.image.revision="${DOTOS_COMMIT}"

RUN bootc container lint
