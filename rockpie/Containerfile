ARG BASE_IMAGE=ghcr.io/talhahavadar/dotos-base:latest

# Radxa ROCK Pi E (RK3328). Firmware: mainline U-Boot + TF-A in a two-slot
# layout below the first partition (see rockpie/rootfs/usr/bin/dotos-firmware
# and `just disk-image-embedded`).
FROM docker.io/library/debian:unstable AS firmware

# Every firmware input lives in rockpie/firmware/. `just build` derives the
# version from that directory's git history (scripts/firmware-version.sh), so
# it changes exactly when the firmware does and dotos-firmware can order it.
ARG FIRMWARE_LOCALVERSION

RUN --mount=type=cache,dst=/var/cache/apt,sharing=locked \
    --mount=type=cache,dst=/var/lib/apt/lists,sharing=locked \
    --mount=type=bind,source=rockpie/firmware/deps.sh,target=/ctx/deps.sh \
    /ctx/deps.sh

RUN --mount=type=bind,source=rockpie/firmware,target=/ctx \
    /ctx/build.sh "$FIRMWARE_LOCALVERSION"

FROM ${BASE_IMAGE}

COPY rockpie/rootfs/ /
COPY --from=firmware /output/ /usr/lib/u-boot/rock-pi-e/

# Before the initramfs rebuild below, which embeds os-release
RUN --mount=type=bind,source=scripts/os-release.sh,target=/ctx/os-release.sh \
    /ctx/os-release.sh variant rockpie "ROCK Pi E"

# Confirm a good firmware boot into the fallback slot on every boot
RUN systemctl enable dotos-firmware-commit.service

# Don't refresh the boot loader random seed from the OS: bootc mounts /boot
# read-only, so the unit fails on every boot. systemd-boot still refreshes
# the seed itself at boot, mixed with the RK3328 hardware RNG that U-Boot
# exposes through EFI_RNG_PROTOCOL.
RUN systemctl mask systemd-boot-random-seed.service

# (/root links to /var/roothome; /var is a tmpfs here and stays empty)
RUN --mount=type=tmpfs,dst=/tmp --mount=type=tmpfs,dst=/var \
    --mount=type=bind,source=scripts/initramfs.sh,target=/ctx/initramfs.sh \
    mkdir -p /var/roothome /var/tmp && \
    /ctx/initramfs.sh

LABEL org.opencontainers.image.title="dotOS ROCK Pi E" \
      org.opencontainers.image.description="dotOS for the Radxa ROCK Pi E, with two-slot U-Boot firmware"

RUN bootc container lint
