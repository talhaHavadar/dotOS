#!/bin/bash
# Replaces Debian's ignition-generator: Ignition always runs, on
# ignition.platform.id or "metal" if unset (no ignition.firstboot, which
# systemd-boot would keep on every boot). Re-runs are stopped by the marker
# checked in 10-dotos-gate.conf instead.

set -e

exec 1>/dev/kmsg; exec 2>&1

UNIT_DIR="${1:-/tmp}"

platform=""
for arg in $(</proc/cmdline); do
    if [[ "${arg%%=*}" == "ignition.platform.id" ]]; then
        platform="${arg#*=}"
    fi
done

add_requires() {
    local name="$1" target="$2"
    mkdir -p "${UNIT_DIR}/${target}.requires"
    ln -sf "../${name}" "${UNIT_DIR}/${target}.requires/${name}"
}

# Defaults to bare metal; the marker (not the karg) stops re-runs
platform="${platform:-metal}"
add_requires ignition-complete.target initrd.target

echo "PLATFORM_ID=${platform}" > /run/ignition.env
