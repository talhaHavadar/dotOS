  "systemd": {
    "units": [
      {
        "name": "talha-user-expire-password.service",
        "enabled": true,
        "contents": "[Unit]\nDescription=Force password change for talha user on first login\nConditionPathExists=!/var/lib/talha-user-expired\nAfter=local-fs.target\n\n[Service]\nType=oneshot\nExecStart=/usr/bin/chage -d 0 talha\nExecStartPost=/usr/bin/touch /var/lib/talha-user-expired\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n"
      }
    ]
  }
}
